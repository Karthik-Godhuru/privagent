# PrivAgent Configuration Example

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=
# Model Name (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
PRIVAGENT_MODEL_NAME=gemini-2.5-flash

# Optional: Override Model Endpoint (Leave empty for default Google AI Studio REST)
# PRIVAGENT_MODEL_ENDPOINT=

# Optional: Model Timeout in seconds (Default: 4.0)
# PRIVAGENT_MODEL_TIMEOUT=4.0
