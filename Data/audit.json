import json
from pydantic import BaseModel, Field, ValidationError
from typing import List, Dict, Optional

class BoundingBox(BaseModel):
    x: int
    y: int
    w: int
    h: int

class SafeLabel(BaseModel):
    id: str
    text: str
    role: str
    bounding_box: BoundingBox

class RedactedRegion(BaseModel):
    id: str
    entity_type: str
    obfuscation_method: str
    bounding_box: BoundingBox
    semantic_tag: str

class SecurityValidation(BaseModel):
    raw_pixels_transmitted: bool = Field(False, description="Must always be false")
    pii_detected_and_masked: bool
    fail_closed_triggered: bool

class SanitizedState(BaseModel):
    metadata: Dict
    safe_labels: List[SafeLabel]
    redacted_regions: List[RedactedRegion]
    action_candidates: List[Dict]
    security_validation: SecurityValidation

def validate_payload(file_path: str):
    """Enforces the privacy boundary before server processing."""
    with open(file_path, 'r') as f:
        data = json.load(f)
    
    try:
        validated_state = SanitizedState(**data)
        if validated_state.security_validation.raw_pixels_transmitted:
            raise ValueError("CRITICAL PRIVACY BREACH: Raw pixels flagged in payload.")
        print("Payload validated. Minimum necessary context preserved.")
        return validated_state
    except ValidationError as e:
        print(f"Validation Error: {e}")
        # Trigger fail-closed protocol
        return None

if __name__ == "__main__":
    # Test the mock data
    validate_payload("sanitized_state.json")
