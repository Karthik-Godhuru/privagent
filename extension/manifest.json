{
  "manifest_version": 3,
  "name": "PRIVAGENT",
  "version": "1.0.0",
  "description": "Privacy-preserving browser AI agent with on-device visual perception.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "privacy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
