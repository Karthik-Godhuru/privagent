{
  "manifest_version": 3,
  "name": "PrivAgent",
  "version": "1.0.0",
  "description": "Privacy-preserving browser AI agent",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  {
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "privacy-gate.js",
        "content.js"
      ]
    }
  ]
}
