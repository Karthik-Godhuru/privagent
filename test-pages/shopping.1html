<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEase - Online Shopping</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->
    <header class="header">

        <div class="logo">
            ShopEase
            <span>Fashion & More</span>
        </div>

        <div class="search-box">
            <span>🔍</span>
            <input
                type="text"
                placeholder="Search for products, brands and more"
            >
        </div>

        <div class="header-actions">

            <div class="account">
                <span>👤</span>
                <div>
                    <small>Hello,</small>
                    <strong>Priya</strong>
                </div>
            </div>

            <div class="orders">
                📦 Orders
            </div>

            <div class="cart">
                🛒 Cart
                <span class="cart-count">2</span>
            </div>

        </div>

    </header>


    <!-- NAVIGATION -->
    <nav class="navbar">

        <a href="#">Women</a>
        <a href="#">Men</a>
        <a href="#">Kids</a>
        <a href="#">Beauty</a>
        <a href="#">Home & Living</a>
        <a href="#">Footwear</a>
        <a href="#">Accessories</a>
        <a href="#">Electronics</a>
        <a href="#">Offers</a>

    </nav>


    <!-- PRIVAGENT TEST BANNER -->
    <section class="privacy-banner">

        <div>
            <span class="shield">🛡️</span>

            <div>
                <strong>PRIVAGENT Privacy Protection Active</strong>
                <p>
                    Sensitive information on this page is protected locally
                    before AI processing.
                </p>
            </div>
        </div>

        <span class="status">
            ● Protected
        </span>

    </section>


    <!-- MAIN CONTENT -->
    <main class="container">

        <!-- DELIVERY CARD -->
        <section class="delivery-card">

            <div class="delivery-header">
                <h3>Deliver to</h3>

                <button class="change-btn">
                    Change
                </button>
            </div>

            <!-- Sensitive test information -->
            <div class="customer-info">

                <strong>Priya Reddy</strong>

                <span class="phone">
                    +91 98765 43210
                </span>

                <p>
                    Flat 402, Green Residency,
                    Madhapur, Hyderabad,
                    Telangana - 500081
                </p>

            </div>

        </section>


        <!-- CATEGORY SECTION -->
        <section class="categories">

            <h2>Shop by Category</h2>

            <div class="category-list">

                <div class="category">
                    <div class="category-icon">👗</div>
                    <span>Women</span>
                </div>

                <div class="category">
                    <div class="category-icon">👕</div>
                    <span>Men</span>
                </div>

                <div class="category">
                    <div class="category-icon">👟</div>
                    <span>Footwear</span>
                </div>

                <div class="category">
                    <div class="category-icon">💄</div>
                    <span>Beauty</span>
                </div>

                <div class="category">
                    <div class="category-icon">👜</div>
                    <span>Bags</span>
                </div>

                <div class="category">
                    <div class="category-icon">⌚</div>
                    <span>Watches</span>
                </div>

                <div class="category">
                    <div class="category-icon">🏠</div>
                    <span>Home</span>
                </div>

                <div class="category">
                    <div class="category-icon">📱</div>
                    <span>Electronics</span>
                </div>

            </div>

        </section>


        <!-- PRODUCTS -->
        <section class="products-section">

            <div class="section-heading">

                <div>
                    <h2>Trending Products</h2>
                    <p>Explore products selected for you</p>
                </div>

                <button class="view-all">
                    View All →
                </button>

            </div>


            <div class="product-grid">

                <!-- PRODUCT 1 -->
                <article class="product-card">

                    <div class="product-image pink">
                        👗

                        <span class="discount">
                            35% OFF
                        </span>

                        <button class="wishlist">
                            ♡
                        </button>
                    </div>

                    <div class="product-details">

                        <h3>Floral Printed Dress</h3>

                        <p class="description">
                            Women's comfortable casual dress
                        </p>

                        <div class="rating">
                            ⭐ 4.5
                            <span>(2,341)</span>
                        </div>

                        <div class="price">
                            ₹899
                            <del>₹1,399</del>
                        </div>

                        <button class="add-cart">
                            Add to Cart
                        </button>

                    </div>

                </article>


                <!-- PRODUCT 2 -->
                <article class="product-card">

                    <div class="product-image blue">

                        👕
                        
                        <span class="discount">
                            42% OFF
                        </span>

                        <button class="wishlist">
                            ♡
                        </button>

                    </div>

                    <div class="product-details">

                        <h3>Premium Cotton T-Shirt</h3>

                        <p class="description">
                            Regular fit casual cotton T-shirt
                        </p>

                        <div class="rating">
                            ⭐ 4.3
                            <span>(1,842)</span>
                        </div>

                        <div class="price">
                            ₹599
                            <del>₹1,049</del>
                        </div>

                        <button class="add-cart">
                            Add to Cart
                        </button>

                    </div>

                </article>


                <!-- PRODUCT 3 -->
                <article class="product-card">

                    <div class="product-image purple">

                        👟

                        <span class="discount">
                            28% OFF
                        </span>

                        <button class="wishlist">
                            ♡
                        </button>

                    </div>

                    <div class="product-details">

                        <h3>Running Sneakers</h3>

                        <p class="description">
                            Lightweight sports shoes
                        </p>

                        <div class="rating">
                            ⭐ 4.6
                            <span>(3,112)</span>
                        </div>

                        <div class="price">
                            ₹1,299
                            <del>₹1,799</del>
                        </div>

                        <button class="add-cart">
                            Add to Cart
                        </button>

                    </div>

                </article>


                <!-- PRODUCT 4 -->
                <article class="product-card">

                    <div class="product-image yellow">

                        👜

                        <span class="discount">
                            50% OFF
                        </span>

                        <button class="wishlist">
                            ♡
                        </button>

                    </div>

                    <div class="product-details">

                        <h3>Women's Handbag</h3>

                        <p class="description">
                            Stylish everyday shoulder bag
                        </p>

                        <div class="rating">
                            ⭐ 4.4
                            <span>(987)</span>
                        </div>

                        <div class="price">
                            ₹749
                            <del>₹1,499</del>
                        </div>

                        <button class="add-cart">
                            Add to Cart
                        </button>

                    </div>

                </article>


                <!-- PRODUCT 5 -->
                <article class="product-card">

                    <div class="product-image green">

                        ⌚

                        <span class="discount">
                            30% OFF
                        </span>

                        <button class="wishlist">
                            ♡
                        </button>

                    </div>

                    <div class="product-details">

                        <h3>Smart Watch</h3>

                        <p class="description">
                            Fitness and activity tracking watch
                        </p>

                        <div class="rating">
                            ⭐ 4.2
                            <span>(4,231)</span>
                        </div>

                        <div class="price">
                            ₹1,499
                            <del>₹2,099</del>
                        </div>

                        <button class="add-cart">
                            Add to Cart
                        </button>

                    </div>

                </article>


                <!-- PRODUCT 6 -->
                <article class="product-card">

                    <div class="product-image orange">

                        💄

                        <span class="discount">
                            25% OFF
                        </span>

                        <button class="wishlist">
                            ♡
                        </button>

                    </div>

                    <div class="product-details">

                        <h3>Beauty Essentials Kit</h3>

                        <p class="description">
                            Everyday personal care collection
                        </p>

                        <div class="rating">
                            ⭐ 4.5
                            <span>(1,543)</span>
                        </div>

                        <div class="price">
                            ₹699
                            <del>₹929</del>
                        </div>

                        <button class="add-cart">
                            Add to Cart
                        </button>

                    </div>

                </article>

            </div>

        </section>


        <!-- ACCOUNT INFORMATION -->
        <section class="account-test-card">

            <div class="account-title">
                <h2>My Account</h2>

                <span class="privacy-tag">
                    🔒 Sensitive
                </span>
            </div>

            <div class="account-grid">

                <div>
                    <label>Full Name</label>
                    <strong>Priya Reddy</strong>
                </div>

                <div>
                    <label>Email</label>
                    <strong>priya.reddy@example.com</strong>
                </div>

                <div>
                    <label>Customer ID</label>
                    <strong>CUST-849271</strong>
                </div>

                <div>
                    <label>Mobile Number</label>
                    <strong>+91 98765 43210</strong>
                </div>

            </div>

        </section>

    </main>


    <!-- FOOTER -->
    <footer>

        <div class="footer-content">

            <div>
                <h3>ShopEase</h3>
                <p>Online shopping made simple.</p>
            </div>

            <div>
                <h4>Customer Service</h4>
                <p>Help Center</p>
                <p>Returns</p>
                <p>Shipping</p>
            </div>

            <div>
                <h4>About</h4>
                <p>About Us</p>
                <p>Careers</p>
                <p>Contact</p>
            </div>

            <div>
                <h4>Privacy</h4>
                <p>Privacy Policy</p>
                <p>Security</p>
                <p>Terms</p>
            </div>

        </div>

        <div class="copyright">
            © 2026 ShopEase. Demo page for PRIVAGENT testing.
        </div>

    </footer>


</body>
</html>